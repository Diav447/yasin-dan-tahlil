<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:background="#121212">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#0F2B1D" android:padding="16dp" android:orientation="vertical">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="يٰسٓ وَ التَّهْلِيْل" android:textColor="#FFD700" android:textSize="20sp" android:textStyle="bold" android:gravity="center"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="YASIN &amp; TAHLIL V3 OFFLINE" android:textColor="#FFFFFF" android:textSize="14sp" android:gravity="center" android:alpha="0.8"/>
 </LinearLayout>
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_dark_card" android:padding="16dp" android:orientation="horizontal">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
     <TextView android:id="@+id/txtJam" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
     <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Surabaya, No Iklan, Offline" android:textColor="#AAAAAA" android:textSize="11sp"/>
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🕌" android:textSize="36sp"/>
   </LinearLayout>

   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FITUR UTAMA" android:textColor="#888888" android:textSize="11sp" android:paddingTop="20dp" android:paddingBottom="8dp" android:letterSpacing="0.1"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
     <TextView android:id="@+id/btnYasin" android:layout_width="0dp" android:layout_height="90dp" android:layout_weight="1" android:layout_margin="5dp" android:background="@drawable/bg_card" android:gravity="center" android:text="📖\nYASIN" android:textColor="#1A1A1A" android:textStyle="bold"/>
     <TextView android:id="@+id/btnTahlil" android:layout_width="0dp" android:layout_height="90dp" android:layout_weight="1" android:layout_margin="5dp" android:background="@drawable/bg_card" android:gravity="center" android:text="🤲\nTAHLIL" android:textColor="#1A1A1A" android:textStyle="bold"/>
     <TextView android:id="@+id/btnDoa" android:layout_width="0dp" android:layout_height="90dp" android:layout_weight="1" android:layout_margin="5dp" android:background="@drawable/bg_card" android:gravity="center" android:text="🕋\nDOA" android:textColor="#1A1A1A" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
     <TextView android:id="@+id/btnQuran" android:layout_width="0dp" android:layout_height="90dp" android:layout_weight="1" android:layout_margin="5dp" android:background="@drawable/bg_card" android:gravity="center" android:text="📜\nQURAN" android:textColor="#1A1A1A" android:textStyle="bold"/>
     <TextView android:id="@+id/btnMaulid" android:layout_width="0dp" android:layout_height="90dp" android:layout_weight="1" android:layout_margin="5dp" android:background="@drawable/bg_card" android:gravity="center" android:text="💚\nMAULID" android:textColor="#1A1A1A" android:textStyle="bold"/>
     <TextView android:id="@+id/btnTasbih" android:layout_width="0dp" android:layout_height="90dp" android:layout_weight="1" android:layout_margin="5dp" android:background="@drawable/bg_card" android:gravity="center" android:text="📿\nTASBIH" android:textColor="#1A1A1A" android:textStyle="bold"/>
    </LinearLayout>
   </LinearLayout>

   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MENU LAINNYA" android:textColor="#888888" android:textSize="11sp" android:paddingTop="16dp" android:paddingBottom="8dp"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <TextView android:id="@+id/btnAsmaul" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_margin="5dp" android:background="@drawable/bg_dark_card" android:gravity="center" android:text="✨ ASMAUL HUSNA" android:textColor="#FFFFFF"/>
    <TextView android:id="@+id/btnJuz" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_margin="5dp" android:background="@drawable/bg_dark_card" android:gravity="center" android:text="📚 JUZ AMMA" android:textColor="#FFFFFF"/>
   </LinearLayout>

   <TextView android:id="@+id/teksContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_kitab" android:padding="18dp" android:layout_marginTop="18dp" android:textColor="#3E2723" android:textSize="20sp" android:lineSpacingExtra="10dp" android:text="Tap menu di atas, bro..."/>
  </LinearLayout>
 </ScrollView>
 <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:background="#0F2B1D" android:orientation="horizontal">
  <TextView android:id="@+id/navBeranda" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="🏠\nBeranda" android:textColor="#FFD700" android:textSize="11sp"/>
  <TextView android:id="@+id/navTahlil" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="🤲\nTahlil" android:textColor="#AAAAAA" android:textSize="11sp"/>
  <TextView android:id="@+id/navDoa" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="🕋\nDoa" android:textColor="#AAAAAA" android:textSize="11sp"/>
  <TextView android:id="@+id/navTasbih2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="📿\nTasbih" android:textColor="#AAAAAA" android:textSize="11sp"/>
  <TextView android:id="@+id/navKalender" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="📅\nHijriah" android:textColor="#AAAAAA" android:textSize="11sp"/>
 </LinearLayout>
</LinearLayout>
