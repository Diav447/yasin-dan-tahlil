<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#FFF8E7">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="12dp" android:background="#1B5E20">
        <TextView android:id="@+id/txtJam" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="white" android:text="8.50 WIB" />
        <Button android:id="@+id/btnMin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A-" />
        <Button android:id="@+id/btnPlus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A+" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tt" android:textColor="white" android:textSize="20sp" android:padding="8dp"/>
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#2E7D32">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnYasin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="YASIN" />
            <Button android:id="@+id/btnTahlil" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TAHLIL" />
            <Button android:id="@+id/btnDoa" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DOA" />
            <Button android:id="@+id/btnAsmaul" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ASMAUL" />
        </LinearLayout>
    </HorizontalScrollView>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <TextView android:id="@+id/teksContent" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="24dp" android:textSize="28sp" android:lineSpacingExtra="12dp"
            android:fontFamily="serif" android:textColor="#000000" />
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="#1B5E20" android:padding="4dp">
        <Button android:id="@+id/navBeranda" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Beranda"/>
        <Button android:id="@+id/navTahlil" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Tahlil"/>
        <Button android:id="@+id/navDoa" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Doa"/>
    </LinearLayout>
</LinearLayout>
