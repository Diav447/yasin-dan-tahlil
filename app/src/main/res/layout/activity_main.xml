<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:background="#121212">
 
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
  android:text="سورة يس و التهلل - OFFLINE" android:textColor="#FFFFFF"
  android:textSize="18sp" android:textStyle="bold" android:gravity="center" android:padding="16dp" android:background="#1E1E1E"/>

 <ScrollView android:id="@+id/scrollContent" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">

    <!-- MENU WAKTU (versi offline, no error input null) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#1E1E1E" android:orientation="vertical" android:padding="16dp">
     <TextView android:id="@+id/txtJam" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="19:43 WIB" android:textColor="white" android:textSize="28sp" android:textStyle="bold"/>
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mode Offline - No Iklan" android:textColor="#AAAAAA" android:textSize="12sp"/>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FITUR UTAMA" android:textColor="#888" android:textSize="12sp" android:paddingTop="16dp" android:paddingBottom="8dp"/>
    <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="3" android:rowCount="2">
      <Button android:id="@+id/btnYasin" android:text="YASIN" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
      <Button android:id="@+id/btnTahlil" android:text="TAHLIL" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
      <Button android:id="@+id/btnDoa" android:text="DOA TAHLIL" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
      <Button android:id="@+id/btnQuran" android:text="AL-QURAN" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
      <Button android:id="@+id/btnMaulid" android:text="MAULID" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
      <Button android:id="@+id/btnTasbih" android:text="TASBIH" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
    </GridLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MENU LAINNYA" android:textColor="#888" android:textSize="12sp" android:paddingTop="16dp" android:paddingBottom="8dp"/>
    <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2">
      <Button android:id="@+id/btnAsmaul" android:text="ASMAUL HUSNA" android:layout_width="0dp" android:layout_height="60dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
      <Button android:id="@+id/btnJuz" android:text="JUZ AMMA" android:layout_width="0dp" android:layout_height="60dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
      <Button android:id="@+id/btnFashol" android:text="FASHOLATAN" android:layout_width="0dp" android:layout_height="60dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
      <Button android:id="@+id/btnIstig" android:text="ISTIGHOSAH" android:layout_width="0dp" android:layout_height="60dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
    </GridLayout>

    <TextView android:id="@+id/teksContent" android:layout_width="match_parent" android:layout_height="wrap_content"
     android:textColor="#E0E0E0" android:textSize="20sp" android:lineSpacingExtra="8dp" android:textDirection="rtl"
     android:background="#FFF8E1" android:text="Pilih menu di atas bro..." android:padding="16dp" android:layout_marginTop="16dp"/>

   </LinearLayout>
 </ScrollView>

 <!-- BOTTOM NAV ala screenshot lu -->
 <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:background="#1E1E1E" android:orientation="horizontal">
  <Button android:id="@+id/navBeranda" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Beranda"/>
  <Button android:id="@+id/navTahlil" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Tahlil"/>
  <Button android:id="@+id/navDoa" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Doa"/>
  <Button android:id="@+id/navTasbih2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Tasbih"/>
  <Button android:id="@+id/navKalender" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Kalender"/>
 </LinearLayout>
</LinearLayout>
